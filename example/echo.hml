// Echo example - Server echoes back packets that client sends
// Hemlock port of gn.js echo.js

import { Server } from "../src/network/server.hml";
import { Client } from "../src/network/client.hml";
import { Packet } from "../src/network/packet.hml";
import { sleep } from "@stdlib/time";

let port = 3000;

// Set up server (echo back all packets)
let server = Server();
server.on("connect", fn(conn) {
    print("Server received connection");
});
server.on("disconnect", fn(conn) {
    print("Server received disconnect");
});
server.on("packet", fn(conn, packet) {
    print("Server received packet: " + packet.data);
    conn.send(packet);
});

// Run server in background
async fn run_server(srv, p) {
    srv.listen(p);
}
spawn(run_server, server, port);
sleep(0.5);

// Connect client
let client = Client();
client.connect("127.0.0.1", port);
print("Client connected");

// Send 5 packets and receive echoes
let i = 0;
while (i < 5) {
    let packet = Packet(1);
    packet.add(i);
    client.send(packet);
    print("Client sent: " + i);

    let echo = client.recv_packet();
    if (echo != null) {
        print("Client received echo: " + echo.get(0));
    }

    sleep(0.5);
    i = i + 1;
}

client.disconnect();
sleep(0.5);
server.close();
