// packet.hml - Binary packet serialization for the gn.hml protocol
// Hemlock port of gn.js Packet.js

import { create_buffer_from_data, parse_data_from_buffer, determine_type, data_size, write_data_to_buffer } from "../util/gm_convert.hml";

// Create a new Packet with the given network ID
// Packet format: [2-byte size (LE)][2-byte netId (LE)][typed data elements...]
export fn Packet(net_id) {
    return {
        net_id: net_id,
        data: [],

        // Push data to the packet (single value or array)
        add: fn(data) {
            let t = typeof(data);
            if (t == "array") {
                let i = 0;
                while (i < data.length) {
                    self.data.push(data[i]);
                    i = i + 1;
                }
            } else {
                self.data.push(data);
            }
        },

        // Access data at index i
        get: fn(i) {
            return self.data[i];
        },

        // Load raw byte data into this packet (deserialize)
        // data: buffer starting after the 2-byte size header
        load: fn(data) {
            if (data.length < 2) {
                return;
            }
            // Read netId as LE u16
            self.net_id = data.read_u16_le(0);

            if (data.length > 2) {
                let i = 2;
                while (i < data.length) {
                    let parse = parse_data_from_buffer(data, i);
                    if (!parse.valid) {
                        break; // malformed/truncated element, stop parsing
                    }
                    self.data.push(parse.data);
                    i = i + parse.size + 1; // +1 for type byte
                }
            }
        },

        // Serialize the packet into a buffer ready to send
        // Returns: buffer with [size(2)][netId(2)][data...]
        build: fn() {
            // First pass: determine types and calculate total size
            let len = self.data.length;
            let types = [];
            types.reserve(len);
            let total_data_size = 0;
            let i = 0;
            while (i < len) {
                let tid = determine_type(self.data[i]);
                types.push(tid);
                total_data_size = total_data_size + data_size(tid, self.data[i]);
                i = i + 1;
            }

            let payload_size = 2 + total_data_size; // 2 for netId
            if (payload_size > 65535) {
                throw "gn: packet payload too large for u16 size field (" + payload_size + " bytes, max 65535)";
            }

            // Single allocation, single pass write
            let result = buffer(2 + payload_size);
            result.write_u16_le(0, payload_size);
            result.write_u16_le(2, self.net_id);

            // Write all data elements directly into result buffer
            let offset = 4;
            i = 0;
            while (i < len) {
                offset = offset + write_data_to_buffer(result, offset, types[i], self.data[i]);
                i = i + 1;
            }

            return result;
        },
    };
}

// Split a raw binary message into Packets.
// Each packet on the wire is [2-byte LE size][payload]; a single WebSocket
// message may carry several packets back to back.
export fn parse_packets(data) {
    let packets = [];
    let offset = 0;
    while (offset + 2 <= data.length) {
        let size = data.read_u16_le(offset);
        if (size == 0 || offset + 2 + size > data.length) {
            break;
        }
        let packet = Packet(0);
        packet.load(data.slice(offset + 2, offset + 2 + size)); // zero-copy view
        packets.push(packet);
        offset = offset + 2 + size;
    }
    return packets;
}
