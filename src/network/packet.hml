// packet.hml - Binary packet serialization for the gn.hml protocol
// Hemlock port of gn.js Packet.js

import { create_buffer_from_data, parse_data_from_buffer, determine_type, data_size, write_data_to_buffer } from "../util/gm_convert.hml";

// Create a new Packet with the given network ID
// Packet format: [2-byte size (LE)][2-byte netId (LE)][typed data elements...]
export fn Packet(net_id) {
    return {
        net_id: net_id,
        data: [],

        // A BOOLEAN CANNOT REACH THE SERIALISER. determine_type lists TYPEID_BOOL with the
        // integer types -- the intent was clearly to support it -- and then immediately does
        // `if (data >= 0)`, which is a numeric comparison on a bool and throws "Binary operation
        // requires numeric operands". So the encoder tried to support booleans and broke on them
        // one line later.
        //
        // Normalising here rather than in determine_type fixes the writer too: write_u8 would
        // have had the same problem with a bool once the type was decided.
        //
        // 1/0 is what the wire has always carried. The GameMaker client sends its own booleans
        // this way and reads them back as truthy numbers, so nothing downstream changes.
        //
        // Found by pointing the real client at a real server: every settings packet before the
        // first boolean went out fine, so this presented as a connection that opened and
        // immediately closed rather than as a serialisation fault.
        normalize_value: fn(v) {
            if (typeof(v) == "bool") {
                if (v) { return 1; }
                return 0;
            }
            return v;
        },

        // Push data to the packet (single value or array)
        add: fn(data) {
            let t = typeof(data);
            if (t == "array") {
                let i = 0;
                while (i < data.length) {
                    self.data.push(self.normalize_value(data[i]));
                    i = i + 1;
                }
            } else {
                self.data.push(self.normalize_value(data));
            }
        },

        // Access data at index i.
        //
        // OUT OF RANGE RETURNS NULL rather than throwing, which is what every caller was written
        // against: this is a port of gn.js, where `data[i]` past the end is undefined.
        //
        // Packets are genuinely shorter than their handlers expect, and legitimately so. The
        // GameMaker client drops trailing values it has nothing to say about -- a player who has
        // never customised sends PLAYER_CUSTOM with four values instead of five -- so a handler
        // reading get(4) threw "Array index 4 out of bounds" on a perfectly ordinary packet from
        // a brand new player.
        get: fn(i) {
            if (i < 0 || i >= self.data.length) {
                return null;
            }
            return self.data[i];
        },

        // Load raw byte data into this packet (deserialize)
        // data: buffer starting after the 2-byte size header
        load: fn(data) {
            if (data.length < 2) {
                return;
            }
            // Read netId as LE u16
            self.net_id = data.read_u16_le(0);

            if (data.length > 2) {
                let i = 2;
                while (i < data.length) {
                    let parse = parse_data_from_buffer(data, i);
                    if (parse.size == 0 && parse.data == null) {
                        break;
                    }
                    self.data.push(parse.data);
                    i = i + parse.size + 1; // +1 for type byte
                }
            }
        },

        // Serialize the packet into a buffer ready to send
        // Returns: buffer with [size(2)][netId(2)][data...]
        build: fn() {
            // First pass: determine types and calculate total size
            let len = self.data.length;
            let types = [];
            types.reserve(len);
            let total_data_size = 0;
            let i = 0;
            while (i < len) {
                let tid = determine_type(self.data[i]);
                types.push(tid);
                total_data_size = total_data_size + data_size(tid, self.data[i]);
                i = i + 1;
            }

            let payload_size = 2 + total_data_size; // 2 for netId
            if (payload_size > 65535) {
                throw "gn: packet payload too large for u16 size field (" + payload_size + " bytes, max 65535)";
            }

            // Single allocation, single pass write
            let result = buffer(2 + payload_size);
            result.write_u16_le(0, payload_size);
            result.write_u16_le(2, self.net_id);

            // Write all data elements directly into result buffer
            let offset = 4;
            i = 0;
            while (i < len) {
                offset = offset + write_data_to_buffer(result, offset, types[i], self.data[i]);
                i = i + 1;
            }

            return result;
        },
    };
}
