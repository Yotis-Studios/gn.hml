// connection.hml - Server-side connection wrapper
// Hemlock port of gn.js Connection.js

import { Packet } from "./packet.hml";

// Create a Connection wrapping a WebSocket connection handle
// close_ch: the connection's receive task listens on it and closes the socket itself (kick).
export fn Connection(ws, server, close_ch?: null) {
    return {
        ws: ws,
        server: server,
        code: null,
        message: null,
        _reporting: false,   // inside on("error") for a failed send on this connection
        _close_ch: close_ch,
        _closing: false,     // kicked: the receive task closes the socket within 100 ms

        // Send a Packet or raw buffer to this connection. Returns whether it was written.
        //
        // A closed connection is not an error: it was kicked, or its close has been seen, and
        // its disconnect event is on the way. Servers send to such connections all the time
        // in the gap (a broadcast, a timer's snapshot, a host switch), and reporting each one
        // as an error invited the handler to answer by sending again. A handler that does
        // send on a failing connection is not reported to recursively either: answered from
        // inside its own catch, every failure made another, until the C stack ran out.
        send: fn(packet) {
            if (self._closing || self.ws.closed) {
                return false;
            }
            let data = null;
            if (typeof(packet) == "object" && packet.build != null) {
                data = packet.build();
            } else {
                data = packet;
            }
            try {
                return self.ws.send_binary(data);
            } catch (e) {
                if (self._reporting) {
                    return false;
                }
                print("Error sending: " + e);
                if (self.server._on_error != null) {
                    self._reporting = true;
                    try {
                        self.server._on_error(e, self);
                    } finally {
                        self._reporting = false;
                    }
                }
            }
            return false;
        },

        // Broadcast a packet to all connections except this one
        broadcast: fn(packet) {
            self.server.broadcast(packet, self);
        },

        // Close this connection.
        //
        // NOT ws.close() FROM HERE. The connection's receive task is inside ws.recv() on its own
        // thread, and closing the socket under it frees the descriptor while that task still
        // holds it: a connection accepted in the next 100 ms can be given the same number, and
        // the old task then reads from it or closes it. Measured in shikikan's rejoin test (a
        // seat turned away, the next connection killed 30 ms after it opened, in about half the
        // runs). The receive task owns the socket, so it closes it, on its next wake-up; this
        // stops sends at once. Without a close channel (a Connection made by hand) it closes
        // directly, as before.
        kick: fn() {
            if (self._closing) { return; }
            self._closing = true;
            if (self._close_ch != null) {
                self._close_ch.send("close");
            } else {
                self.ws.close();
            }
        },
    };
}
