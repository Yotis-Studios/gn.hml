// client.hml - WebSocket client that connects to a server
// Hemlock port of gn.js Client.js
//
// connect() is non-blocking. A background recv loop pushes events
// to a channel. Call run() to block and dispatch events, or call
// recv_packet() to manually receive one packet at a time.

import { WebSocket } from "@stdlib/websocket";
import { Packet } from "./packet.hml";

// Background recv loop - pushes events to channel
async fn recv_loop(ws, event_ch) {
    while (true) {
        let msg = ws.recv(100);
        if (msg == null) {
            if (ws.closed) {
                break;
            }
            continue;
        }
        if (msg.type == "close") {
            break;
        }
        if (msg.type == "binary") {
            event_ch.send({ type: "data", binary: msg.binary });
        }
    }
    event_ch.send({ type: "disconnect" });
}

// Parse packets from binary data
fn parse_packets(data) {
    let packets = [];
    let offset = 0;
    while (offset + 2 <= data.length) {
        let size = data[offset] | (data[offset + 1] << 8);
        if (size == 0 || offset + 2 + size > data.length) {
            break;
        }
        let payload = buffer(size);
        let i = 0;
        while (i < size) {
            payload[i] = data[offset + 2 + i];
            i = i + 1;
        }
        let packet = Packet(0);
        packet.load(payload);
        packets.push(packet);
        offset = offset + 2 + size;
    }
    return packets;
}

// Create a new Client
export fn Client() {
    return {
        _ws: null,
        _connected: false,
        _event_ch: null,
        _on_connect: null,
        _on_packet: null,
        _on_disconnect: null,
        _on_error: null,

        on: fn(event, callback) {
            if (event == "connect") { self._on_connect = callback; }
            else if (event == "packet") { self._on_packet = callback; }
            else if (event == "disconnect") { self._on_disconnect = callback; }
            else if (event == "error") { self._on_error = callback; }
        },

        // Connect to a server (non-blocking)
        connect: fn(address, port) {
            let url = "ws://" + address + ":" + port;
            try {
                self._ws = WebSocket(url);
                self._connected = true;
                self._event_ch = channel(256);
                spawn(recv_loop, self._ws, self._event_ch);
                if (self._on_connect != null) {
                    self._on_connect();
                }
            } catch (e) {
                print("Connection error: " + e);
                if (self._on_error != null) {
                    self._on_error(e);
                }
            }
        },

        // Block and run the client event loop, dispatching callbacks.
        // Blocks until disconnected or close() is called.
        run: fn() {
            if (self._event_ch == null) {
                return;
            }
            while (self._connected) {
                let event = self._event_ch.recv();
                if (event == null) {
                    break;
                }
                if (event.type == "data") {
                    let packets = parse_packets(event.binary);
                    let i = 0;
                    while (i < packets.length) {
                        if (self._on_packet != null) {
                            self._on_packet(packets[i]);
                        }
                        i = i + 1;
                    }
                } else if (event.type == "disconnect") {
                    self._connected = false;
                    if (self._on_disconnect != null) {
                        self._on_disconnect();
                    }
                }
            }
        },

        // Receive a single packet (blocking). Returns null on disconnect.
        recv_packet: fn() {
            if (self._event_ch == null || !self._connected) {
                return null;
            }
            while (self._connected) {
                let event = self._event_ch.recv();
                if (event == null) {
                    return null;
                }
                if (event.type == "data") {
                    let packets = parse_packets(event.binary);
                    if (packets.length > 0) {
                        return packets[0];
                    }
                } else if (event.type == "disconnect") {
                    self._connected = false;
                    return null;
                }
            }
            return null;
        },

        send: fn(packet) {
            if (self._ws == null) {
                print("Cannot send packet, WebSocket is null");
                return;
            }
            if (!self._connected) {
                print("Cannot send packet, not connected");
                return;
            }
            let data = packet.build();
            self._ws.send_binary(data);
        },

        disconnect: fn() {
            if (self._ws != null) {
                self._connected = false;
                self._ws.close();
            }
            if (self._event_ch != null) {
                self._event_ch.send({ type: "disconnect" });
            }
        },

        is_connected: fn() {
            return self._connected;
        },
    };
}
