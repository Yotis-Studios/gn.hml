// server.hml - WebSocket server that manages multiple client connections
// Hemlock port of gn.js Server.js
//
// listen() blocks the calling thread and runs an event loop that
// dispatches connect/packet/disconnect events to registered callbacks.
// Recv loops for each connection push events through a shared channel.

import { WebSocketServer } from "@stdlib/websocket";
import { parse_packets } from "./packet.hml";
import { Connection } from "./connection.hml";
import { time_ms } from "@stdlib/time";

// Per-connection receive loop - pushes events onto shared channel. It owns the socket: a kick
// (Connection.kick) asks it to close through close_ch, and it does between two reads.
async fn connection_recv_loop(ws_conn, conn_id, event_ch, close_ch) {
    try {
        while (!ws_conn.closed) {
            if (select([close_ch], 0) != null) {
                ws_conn.close();
                break;
            }
            let msg = ws_conn.recv(100);
            if (msg == null) {
                if (ws_conn.closed) {
                    break;
                }
                continue;
            }
            if (msg.type == "close") {
                break;
            }
            if (msg.type == "binary") {
                event_ch.send({ type: "data", conn_id: conn_id, binary: msg.binary });
            } else if (msg.type == "text") {
                event_ch.send({ type: "text", conn_id: conn_id, data: msg.data });
            }
        }
    } catch (e) {
        // Connection was closed, exit gracefully
    }
    try {
        event_ch.send({ type: "disconnect", conn_id: conn_id });
    } catch (e) {
        // Channel may be closed
    }
}

// Accept loop - pushes new connections onto shared channel
// Uses a stop channel to know when to exit before ws_server.close()
async fn accept_loop(ws_server, event_ch, stop_ch) {
    while (true) {
        // Check if we should stop (non-blocking via select with 0 timeout)
        let stop = select([stop_ch], 0);
        if (stop != null) {
            break;
        }
        try {
            let ws_conn = ws_server.accept(500);
            if (ws_conn != null) {
                event_ch.send({ type: "connect", ws_conn: ws_conn });
            }
        } catch (e) {
            break; // Server was closed
        }
    }
    // Signal that we've stopped
    stop_ch.send("stopped");
}

// Timer task - posts "timer" events for one every() registration
//
// Deadlines are absolute (start + k * ms), so the period does not drift with
// scheduling delay. At most one event per timer is waiting on the event loop:
// the task takes the token before posting and the loop gives it back after
// the callback, so a slow loop is told how many periods passed instead of
// receiving a queue of them.
async fn timer_loop(timer_id, ms, event_ch, stop_ch, token_ch) {
    let start = time_ms();
    let elapsed = 0;   // periods that have passed
    let posted = 0;    // periods already handed to the loop
    while (true) {
        // ms may be fractional (1000 / 30); select() takes whole milliseconds,
        // so round the wait up rather than wake early and spin
        let wait = start + (elapsed + 1) * ms - time_ms();
        let wait_ms = 0;
        if (wait > 0) {
            wait_ms = integer(wait);
            if (wait_ms < wait) {
                wait_ms = wait_ms + 1;
            }
        }
        if (select([stop_ch], wait_ms) != null) {
            break;
        }
        let now = time_ms();
        while (start + (elapsed + 1) * ms <= now) {
            elapsed = elapsed + 1;
        }
        if (elapsed > posted && select([token_ch], 0) != null) {
            try {
                event_ch.send({ type: "timer", timer_id: timer_id, periods: elapsed - posted });
            } catch (e) {
                break; // Channel closed
            }
            posted = elapsed;
        }
    }
}

// Create a new Server
//
// spawn() deep-copies the server, so the copy running listen() is not the
// caller's copy. The channels are created here because channels are shared
// across spawn rather than copied: close() on any copy signals the listening
// task through _event_ch, and that task closes _done_ch once it has shut down.
export fn Server() {
    return {
        _connections: [],
        _conn_map: [],
        _recv_tasks: [],
        _ws_server: null,
        _port: null,
        _closed: false,
        _event_ch: channel(256),
        _done_ch: channel(1),
        _stop_ch: null,
        _next_conn_id: 0,
        _timers: [],
        _next_timer_id: 0,
        _listening: false,
        _on_ready: null,
        _on_connect: null,
        _on_packet: null,
        _on_disconnect: null,
        _on_error: null,

        on: fn(event, callback) {
            if (event == "ready") { self._on_ready = callback; }
            else if (event == "connect") { self._on_connect = callback; }
            else if (event == "packet") { self._on_packet = callback; }
            else if (event == "disconnect") { self._on_disconnect = callback; }
            else if (event == "error") { self._on_error = callback; }
        },

        // Call fn(periods, server) on the event loop's thread every ms milliseconds,
        // where periods is how many have passed since the last call (1 unless
        // the loop fell behind; the caller decides how much to catch up).
        // server is the listening copy (spawn() copies the one you hold), so
        // broadcast() and the connection list there are the live ones.
        // Register before listen(), or from inside a callback; a copy of the
        // server in another task cannot add timers to a running loop.
        // Returns an id for cancel().
        every: fn(ms, callback) {
            if (ms <= 0) {
                throw "every(): ms must be positive, got " + ms;
            }
            let timer = {
                id: self._next_timer_id,
                ms: ms,
                callback: callback,
                stop_ch: channel(2),
                token_ch: channel(1),
                task: null,
            };
            self._next_timer_id = self._next_timer_id + 1;
            self._timers.push(timer);
            if (self._listening) {
                self._start_timer(timer);
            }
            return timer.id;
        },

        // Stop a timer. From the listening task, or before listen().
        cancel: fn(timer_id) {
            let i = 0;
            while (i < self._timers.length) {
                if (self._timers[i].id == timer_id) {
                    self._stop_timer(self._timers[i]);
                    self._timers.remove(i);
                    return true;
                }
                i = i + 1;
            }
            return false;
        },

        _start_timer: fn(timer) {
            timer.token_ch.send("token");
            timer.task = spawn(timer_loop, timer.id, timer.ms, self._event_ch, timer.stop_ch, timer.token_ch);
        },

        // Called on the loop's own thread, so it must not wait: the task may
        // be blocked posting to the event channel this thread drains. It
        // sees the stop at its next deadline; an event it already posted is
        // dropped because the timer is no longer registered.
        _stop_timer: fn(timer) {
            if (timer.task == null) {
                return;
            }
            timer.stop_ch.send("stop");
            detach(timer.task);
            timer.task = null;
        },

        // Start listening. BLOCKS the calling thread and runs the event loop.
        // Register all callbacks with on() before calling this.
        listen: fn(port) {
            self._port = port;
            self._stop_ch = channel(2);

            try {
                self._ws_server = WebSocketServer("0.0.0.0", port);
            } catch (e) {
                print("Server error: " + e);
                if (self._on_error != null) {
                    // No specific connection caused a bind/listen failure --
                    // pass null, matching connection.hml's (err, connection)
                    // convention and connection.send()'s own _on_error call.
                    self._on_error(e, null);
                }
                self._done_ch.close();
                return;
            }

            print("Server listening on port " + port);
            spawn(accept_loop, self._ws_server, self._event_ch, self._stop_ch);

            self._listening = true;
            let t = 0;
            while (t < self._timers.length) {
                self._start_timer(self._timers[t]);
                t = t + 1;
            }

            if (self._on_ready != null) {
                self._on_ready();
            }

            // Event loop - blocks here, dispatching events
            while (!self._closed) {
                let event = self._event_ch.recv();
                if (event == null) {
                    break;
                }

                if (event.type == "shutdown") {
                    break;
                }

                if (event.type == "timer") {
                    let timer = null;
                    let i = 0;
                    while (i < self._timers.length) {
                        if (self._timers[i].id == event.timer_id) {
                            timer = self._timers[i];
                            break;
                        }
                        i = i + 1;
                    }
                    // A cancelled timer's last event can still be queued
                    if (timer != null) {
                        try {
                            timer.callback(event.periods, self);
                        } catch (e) {
                            print("Error in timer handler: " + e);
                            if (self._on_error != null) {
                                self._on_error(e, null);
                            }
                        }
                        timer.token_ch.send("token");
                    }

                } else if (event.type == "connect") {
                    let conn_id = self._next_conn_id;
                    self._next_conn_id = self._next_conn_id + 1;

                    let close_ch = channel(1);
                    let connection = Connection(event.ws_conn, self, close_ch);
                    self._connections.push(connection);
                    self._conn_map.push({ id: conn_id, conn: connection });

                    let recv_task = spawn(connection_recv_loop, event.ws_conn, conn_id, self._event_ch, close_ch);
                    self._recv_tasks.push(recv_task);

                    if (self._on_connect != null) {
                        try {
                            self._on_connect(connection);
                        } catch (e) {
                            print("Error in connect handler: " + e);
                            if (self._on_error != null) {
                                self._on_error(e, connection);
                            }
                        }
                    }

                } else if (event.type == "data") {
                    let connection = null;
                    let i = 0;
                    while (i < self._conn_map.length) {
                        if (self._conn_map[i].id == event.conn_id) {
                            connection = self._conn_map[i].conn;
                            break;
                        }
                        i = i + 1;
                    }
                    if (connection != null) {
                        let packets = parse_packets(event.binary);
                        let j = 0;
                        while (j < packets.length) {
                            if (self._on_packet != null) {
                                try {
                                    self._on_packet(connection, packets[j]);
                                } catch (e) {
                                    print("Error in packet handler: " + e);
                                    if (self._on_error != null) {
                                        self._on_error(e, connection);
                                    }
                                }
                            }
                            j = j + 1;
                        }
                    }

                } else if (event.type == "text") {
                    // Text frames aren't part of the protocol; report them like gn.js
                    let err = "Received non-binary data: " + event.data;
                    print(err);
                    let connection = null;
                    let i = 0;
                    while (i < self._conn_map.length) {
                        if (self._conn_map[i].id == event.conn_id) {
                            connection = self._conn_map[i].conn;
                            break;
                        }
                        i = i + 1;
                    }
                    if (self._on_error != null) {
                        self._on_error(err, connection);
                    }

                } else if (event.type == "disconnect") {
                    let connection = null;
                    let i = 0;
                    while (i < self._conn_map.length) {
                        if (self._conn_map[i].id == event.conn_id) {
                            connection = self._conn_map[i].conn;
                            self._conn_map.remove(i);
                            break;
                        }
                        i = i + 1;
                    }
                    if (connection != null) {
                        i = 0;
                        while (i < self._connections.length) {
                            if (self._connections[i] == connection) {
                                self._connections.remove(i);
                                break;
                            }
                            i = i + 1;
                        }
                        connection.code = 1000;
                        connection.message = "closed";
                        if (self._on_disconnect != null) {
                            try {
                                self._on_disconnect(connection);
                            } catch (e) {
                                print("Error in disconnect handler: " + e);
                                if (self._on_error != null) {
                                    self._on_error(e, connection);
                                }
                            }
                        }
                    }
                }
            }
            self._shutdown();
        },

        broadcast: fn(packet, exclude?: null) {
            let data = null;
            if (typeof(packet) == "object" && packet.build != null) {
                data = packet.build();
            } else {
                data = packet;
            }
            let i = 0;
            while (i < self._connections.length) {
                if (self._connections[i] != exclude) {
                    self._connections[i].send(data);
                }
                i = i + 1;
            }
        },

        // Stop the server. Safe to call from any task (including the one that
        // spawned listen()) and from inside a callback; repeat calls are no-ops.
        // From another task it blocks until the listening task has shut down.
        close: fn() {
            self._event_ch.send({ type: "shutdown" });
            // The copy running listen() owns the socket; waiting for itself
            // from inside a callback would deadlock
            if (self._ws_server == null) {
                select([self._done_ch], 5000);
            }
        },

        // Runs on the listening task once the event loop exits
        _shutdown: fn() {
            self._closed = true;
            self._listening = false;
            // Stop the timers and wait for them, draining their pending
            // events so none is left blocked posting to the event channel
            let t = 0;
            while (t < self._timers.length) {
                if (self._timers[t].task != null) {
                    self._timers[t].stop_ch.send("stop");
                }
                t = t + 1;
            }
            while (select([self._event_ch], 0) != null) { }
            t = 0;
            while (t < self._timers.length) {
                if (self._timers[t].task != null) {
                    try { join(self._timers[t].task); } catch (e) { }
                    self._timers[t].task = null;
                }
                t = t + 1;
            }
            // Kick all client connections (sets ws_conn.closed = true)
            let i = 0;
            while (i < self._connections.length) {
                self._connections[i].kick();
                i = i + 1;
            }
            // Wait for all recv loop tasks to finish before destroying
            // the server. Recv loops check ws_conn.closed and exit, but
            // we must join them so they are no longer touching the
            // underlying C connection/server memory when we free it.
            i = 0;
            while (i < self._recv_tasks.length) {
                try { join(self._recv_tasks[i]); } catch (e) { }
                i = i + 1;
            }
            self._recv_tasks = [];
            // Signal accept loop to stop and wait for it
            self._stop_ch.send("stop");
            // Wait for accept loop to acknowledge (up to 2s)
            select([self._stop_ch], 2000);
            // Now safe to close the ws server - all tasks that touched
            // ws_conn handles have been joined, so no use-after-free.
            self._ws_server.close();
            print("Server on port " + self._port + " closed");
            self._done_ch.close();
        },
    };
}
