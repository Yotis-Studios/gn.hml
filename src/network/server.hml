// server.hml - WebSocket server that manages multiple client connections
// Hemlock port of gn.js Server.js
//
// listen() blocks the calling thread and runs an event loop that
// dispatches connect/packet/disconnect events to registered callbacks.
// Recv loops for each connection push events through a shared channel.
//
// spawn() deep-copies the server object but retains (shares) channels,
// so the channels are created in the constructor: that is what lets
// close() on the caller's copy reach the event loop running in the
// spawned task's copy.

import { WebSocketServer } from "@stdlib/websocket";
import { Packet, parse_packets } from "./packet.hml";
import { Connection } from "./connection.hml";

// Per-connection receive loop - pushes events onto shared channel
async fn connection_recv_loop(ws_conn, conn_id, event_ch) {
    try {
        while (!ws_conn.closed) {
            let msg = ws_conn.recv(100);
            if (msg == null) {
                if (ws_conn.closed) {
                    break;
                }
                continue;
            }
            if (msg.type == "close") {
                break;
            }
            if (msg.type == "binary") {
                event_ch.send({ type: "data", conn_id: conn_id, binary: msg.binary });
            }
        }
    } catch (e) {
        // Connection was closed, exit gracefully
    }
    try {
        event_ch.send({ type: "disconnect", conn_id: conn_id });
    } catch (e) {
        // Channel may be closed
    }
}

// Accept loop - pushes new connections onto shared channel
// stop_ch signals it to exit; the ack goes on a SEPARATE channel so the
// teardown code cannot steal its own "stop" message off stop_ch and close
// the ws server while this loop is still inside accept() (use-after-free).
async fn accept_loop(ws_server, event_ch, stop_ch, stopped_ch) {
    while (true) {
        // Check if we should stop (non-blocking via select with 0 timeout)
        let stop = select([stop_ch], 0);
        if (stop != null) {
            break;
        }
        try {
            let ws_conn = ws_server.accept(500);
            if (ws_conn != null) {
                event_ch.send({ type: "connect", ws_conn: ws_conn });
            }
        } catch (e) {
            break; // Server was closed
        }
    }
    // Signal that we've stopped
    stopped_ch.send("stopped");
}

// Create a new Server
export fn Server() {
    return {
        _conn_map: [], // { id, conn } entries for live connections
        _recv_tasks: [],
        _ws_server: null,
        _port: null,
        _closed: false,
        // Created here rather than in listen() so a close() from another
        // task's deep copy of this object shares them (see header comment)
        _event_ch: channel(256),
        _stop_ch: channel(2),
        _stopped_ch: channel(1),
        _done_ch: channel(1),
        _next_conn_id: 0,
        _on_ready: null,
        _on_connect: null,
        _on_packet: null,
        _on_disconnect: null,
        _on_error: null,

        on: fn(event, callback) {
            if (event == "ready") { self._on_ready = callback; }
            else if (event == "connect") { self._on_connect = callback; }
            else if (event == "packet") { self._on_packet = callback; }
            else if (event == "disconnect") { self._on_disconnect = callback; }
            else if (event == "error") { self._on_error = callback; }
        },

        // Start listening. BLOCKS the calling thread and runs the event loop.
        // Register all callbacks with on() before calling this.
        listen: fn(port) {
            self._port = port;

            try {
                self._ws_server = WebSocketServer("0.0.0.0", port);
            } catch (e) {
                print("Server error: " + e);
                if (self._on_error != null) {
                    self._on_error(e);
                }
                return;
            }

            print("Server listening on port " + port);
            spawn(accept_loop, self._ws_server, self._event_ch, self._stop_ch, self._stopped_ch);

            if (self._on_ready != null) {
                self._on_ready();
            }

            // Event loop - blocks here, dispatching events
            while (!self._closed) {
                let event = self._event_ch.recv();
                if (event == null) {
                    break;
                }

                if (event.type == "shutdown") {
                    self._closed = true;
                    break;
                }

                if (event.type == "connect") {
                    let conn_id = self._next_conn_id;
                    self._next_conn_id = self._next_conn_id + 1;

                    let connection = Connection(event.ws_conn, self);
                    self._conn_map.push({ id: conn_id, conn: connection });

                    let recv_task = spawn(connection_recv_loop, event.ws_conn, conn_id, self._event_ch);
                    self._recv_tasks.push(recv_task);

                    if (self._on_connect != null) {
                        self._on_connect(connection);
                    }

                } else if (event.type == "data") {
                    let connection = null;
                    let i = 0;
                    while (i < self._conn_map.length) {
                        if (self._conn_map[i].id == event.conn_id) {
                            connection = self._conn_map[i].conn;
                            break;
                        }
                        i = i + 1;
                    }
                    if (connection != null) {
                        let packets = parse_packets(event.binary);
                        let j = 0;
                        while (j < packets.length) {
                            if (self._on_packet != null) {
                                self._on_packet(connection, packets[j]);
                            }
                            j = j + 1;
                        }
                    }

                } else if (event.type == "disconnect") {
                    let connection = null;
                    let i = 0;
                    while (i < self._conn_map.length) {
                        if (self._conn_map[i].id == event.conn_id) {
                            connection = self._conn_map[i].conn;
                            self._conn_map.remove(i);
                            break;
                        }
                        i = i + 1;
                    }
                    if (connection != null) {
                        connection.code = 1000;
                        connection.message = "closed";
                        if (self._on_disconnect != null) {
                            self._on_disconnect(connection);
                        }
                    }
                }
            }

            // Teardown runs here, on the task that owns _ws_server and the
            // connection handles - close() may have been called on a
            // different deep copy that can only reach us via _event_ch.
            // Kick all client connections (sets ws_conn.closed = true)
            let i = 0;
            while (i < self._conn_map.length) {
                self._conn_map[i].conn.kick();
                i = i + 1;
            }
            // Join recv loop tasks so they are no longer touching the
            // underlying C connection/server memory when we free it.
            i = 0;
            while (i < self._recv_tasks.length) {
                try { join(self._recv_tasks[i]); } catch (e) { }
                i = i + 1;
            }
            self._recv_tasks = [];
            // Signal accept loop to stop and wait for its acknowledgement
            // (worst case it is inside a 500ms accept() call)
            self._stop_ch.send("stop");
            select([self._stopped_ch], 2000);
            // The server has now logically stopped: no event loop, no
            // accept loop, all clients kicked and recv tasks joined.
            // Acknowledge close() BEFORE freeing the OS resources -
            // destroying the lws context blocks for many seconds in the
            // current Hemlock runtime (lws_context_destroy stall), and
            // callers should not have to wait for that.
            self._done_ch.send("done");
            self._ws_server.close();
            print("Server on port " + self._port + " closed");
        },

        broadcast: fn(packet, exclude) {
            let data = null;
            if (typeof(packet) == "object" && packet.build != null) {
                data = packet.build();
            } else {
                data = packet;
            }
            let i = 0;
            while (i < self._conn_map.length) {
                if (self._conn_map[i].conn != exclude) {
                    self._conn_map[i].conn.send(data);
                }
                i = i + 1;
            }
        },

        // Stop the server: the event loop exits, all clients are kicked,
        // and the accept loop stops before this returns (up to ~3s).
        // The underlying socket/context is then freed asynchronously by
        // the server task (slow in the current Hemlock runtime), so
        // binding the same port again immediately may fail.
        close: fn() {
            self._closed = true;
            // The event loop may be running in another task's deep copy of
            // this object; the shared channel is the only way to reach it.
            self._event_ch.send({ type: "shutdown" });
            if (self._ws_server == null) {
                // We are not the copy running listen(): wait until the
                // event loop task confirms the server has stopped.
                select([self._done_ch], 3000);
            }
        },
    };
}
