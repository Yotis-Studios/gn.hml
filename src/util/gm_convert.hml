// gm_convert.hml - Binary data type conversion for the gn.hml protocol
// Hemlock port of gn.js gmConvert.js

import { from_bytes } from "@stdlib/strings";
import { INF, NAN } from "@stdlib/math";

let TYPE_U8 = 0;
let TYPE_U16 = 1;
let TYPE_U32 = 2;
let TYPE_S8 = 3;
let TYPE_S16 = 4;
let TYPE_S32 = 5;
let TYPE_F16 = 6;
let TYPE_F32 = 7;
let TYPE_F64 = 8;
let TYPE_STRING = 9;
let TYPE_BUFFER = 10;
let TYPE_UNDEFINED = 11;

let TYPE_COUNT = 12;

// Size in bytes for fixed-size types
let size_map = [1, 2, 4, 1, 2, 4, 2, 4, 8, 0, 0, 0];

// Determine the optimal binary type for a value
// Uses typeid() for fast integer comparison instead of typeof() string matching
export fn determine_type(data) {
    let t = typeid(data);

    if (t == TYPEID_I32 || t == TYPEID_I64 || t == TYPEID_U8 || t == TYPEID_U16 || t == TYPEID_U32 || t == TYPEID_U64 || t == TYPEID_I8 || t == TYPEID_I16 || t == TYPEID_BOOL) {
        // Integer types
        if (data >= 0) {
            if (data < 256) {
                return TYPE_U8;
            } else if (data < 65536) {
                return TYPE_U16;
            } else if (data < 4294967296) {
                return TYPE_U32;
            }
            throw "gn: integer too large for u32 (" + data + ", max 4294967295)";
        } else {
            if (data > -129) {
                return TYPE_S8;
            } else if (data > -32769) {
                return TYPE_S16;
            } else if (data > -2147483649) {
                return TYPE_S32;
            }
            throw "gn: integer too small for s32 (" + data + ", min -2147483648)";
        }
    } else if (t == TYPEID_F32 || t == TYPEID_F64) {
        // Float types
        let abs_val = data;
        if (abs_val < 0) {
            abs_val = 0 - abs_val;
        }
        if (abs_val <= 16777216) {
            return TYPE_F32;
        }
        return TYPE_F64;
    } else if (t == TYPEID_STRING) {
        return TYPE_STRING;
    } else if (t == TYPEID_BUFFER) {
        return TYPE_BUFFER;
    }

    return TYPE_UNDEFINED;
}

// Create a buffer from a single data value, prefixed with its type byte
// Returns: buffer containing [type_byte, ...data_bytes]
export fn create_buffer_from_data(data) {
    let type_id = determine_type(data);

    if (type_id == TYPE_U8) {
        let buf = buffer(2);
        buf.write_u8(0, type_id);
        buf.write_u8(1, data);
        return buf;
    } else if (type_id == TYPE_U16) {
        let buf = buffer(3);
        buf.write_u8(0, type_id);
        buf.write_u16_le(1, data);
        return buf;
    } else if (type_id == TYPE_U32) {
        let buf = buffer(5);
        buf.write_u8(0, type_id);
        buf.write_u32_le(1, data);
        return buf;
    } else if (type_id == TYPE_S8) {
        let buf = buffer(2);
        buf.write_u8(0, type_id);
        buf.write_i8(1, data);
        return buf;
    } else if (type_id == TYPE_S16) {
        let buf = buffer(3);
        buf.write_u8(0, type_id);
        buf.write_i16_le(1, data);
        return buf;
    } else if (type_id == TYPE_S32) {
        let buf = buffer(5);
        buf.write_u8(0, type_id);
        buf.write_i32_le(1, data);
        return buf;
    } else if (type_id == TYPE_F32) {
        let buf = buffer(5);
        buf.write_u8(0, type_id);
        buf.write_f32_le(1, data);
        return buf;
    } else if (type_id == TYPE_F64) {
        let buf = buffer(9);
        buf.write_u8(0, type_id);
        buf.write_f64_le(1, data);
        return buf;
    } else if (type_id == TYPE_STRING) {
        let byte_len = data.byte_length;
        let str_len = byte_len + 1;
        if (str_len > 65535) {
            throw "gn: string too large for u16 length field (" + byte_len + " bytes, max 65534)";
        }
        let buf = buffer(1 + 2 + str_len);
        buf.write_u8(0, type_id);
        buf.write_u16_le(1, str_len);
        memcpy(buffer_ptr(buf) + 3, data.byte_ptr(), byte_len);
        buf.write_u8(3 + byte_len, 0);
        return buf;
    } else if (type_id == TYPE_BUFFER) {
        let buf_len = data.length;
        if (buf_len > 255) {
            throw "gn: buffer too large for u8 length field (" + buf_len + " bytes, max 255)";
        }
        let buf = buffer(1 + 1 + buf_len);
        buf.write_u8(0, type_id);
        buf.write_u8(1, buf_len);
        buf.write_bytes(2, data, buf_len);
        return buf;
    }

    // TYPE_UNDEFINED
    let buf = buffer(1);
    buf.write_u8(0, type_id);
    return buf;
}

// Calculate the total byte size for a typed data element (type byte + data bytes)
export fn data_size(type_id, data) {
    if (type_id <= TYPE_S32) {
        return 1 + size_map[type_id]; // type + fixed size
    } else if (type_id == TYPE_F32) {
        return 5;
    } else if (type_id == TYPE_F64) {
        return 9;
    } else if (type_id == TYPE_STRING) {
        return 1 + 2 + data.byte_length + 1; // type + len(2) + bytes + null
    } else if (type_id == TYPE_BUFFER) {
        return 1 + 1 + data.length; // type + len(1) + bytes
    }
    return 1; // TYPE_UNDEFINED: just the type byte
}

// Write a typed data element directly into buf at the given offset
// Returns: number of bytes written
export fn write_data_to_buffer(buf, offset, type_id, data) {
    buf.write_u8(offset, type_id);
    offset = offset + 1;

    if (type_id == TYPE_U8) {
        buf.write_u8(offset, data);
        return 2;
    } else if (type_id == TYPE_U16) {
        buf.write_u16_le(offset, data);
        return 3;
    } else if (type_id == TYPE_U32) {
        buf.write_u32_le(offset, data);
        return 5;
    } else if (type_id == TYPE_S8) {
        buf.write_i8(offset, data);
        return 2;
    } else if (type_id == TYPE_S16) {
        buf.write_i16_le(offset, data);
        return 3;
    } else if (type_id == TYPE_S32) {
        buf.write_i32_le(offset, data);
        return 5;
    } else if (type_id == TYPE_F32) {
        buf.write_f32_le(offset, data);
        return 5;
    } else if (type_id == TYPE_F64) {
        buf.write_f64_le(offset, data);
        return 9;
    } else if (type_id == TYPE_STRING) {
        let byte_len = data.byte_length;
        let str_len = byte_len + 1; // +1 for null terminator
        if (str_len > 65535) {
            throw "gn: string too large for u16 length field (" + byte_len + " bytes, max 65534)";
        }
        buf.write_u16_le(offset, str_len);
        memcpy(buffer_ptr(buf) + offset + 2, data.byte_ptr(), byte_len);
        buf.write_u8(offset + 2 + byte_len, 0); // null terminator
        return 1 + 2 + str_len; // type already written
    } else if (type_id == TYPE_BUFFER) {
        let buf_len = data.length;
        if (buf_len > 255) {
            throw "gn: buffer too large for u8 length field (" + buf_len + " bytes, max 255)";
        }
        buf.write_u8(offset, buf_len);
        buf.write_bytes(offset + 1, data, buf_len);
        return 1 + 1 + buf_len;
    }

    // TYPE_UNDEFINED
    return 1;
}

// Parse a typed data value from a buffer at the given index
// Returns: { data: <value>, size: <bytes consumed after type byte>, valid: <bool> }
// valid is false for malformed input (unknown type, truncated data) and
// true otherwise — including TYPE_UNDEFINED, which is a legitimate value
// that also has data == null and size == 0.
export fn parse_data_from_buffer(buf, index) {
    if (index >= buf.length) {
        return { data: null, size: 0, valid: false };
    }

    let type_id = buf[index];
    if (type_id >= TYPE_COUNT) {
        return { data: null, size: 0, valid: false };
    }

    index = index + 1;

    // All fixed-size types: reject truncated buffers instead of throwing
    if (type_id <= TYPE_F64 && index + size_map[type_id] > buf.length) {
        return { data: null, size: 0, valid: false };
    }

    if (type_id == TYPE_U8) {
        return { data: buf.read_u8(index), size: 1, valid: true };
    } else if (type_id == TYPE_U16) {
        return { data: buf.read_u16_le(index), size: 2, valid: true };
    } else if (type_id == TYPE_U32) {
        return { data: buf.read_u32_le(index), size: 4, valid: true };
    } else if (type_id == TYPE_S8) {
        return { data: buf.read_i8(index), size: 1, valid: true };
    } else if (type_id == TYPE_S16) {
        return { data: buf.read_i16_le(index), size: 2, valid: true };
    } else if (type_id == TYPE_S32) {
        return { data: buf.read_i32_le(index), size: 4, valid: true };
    } else if (type_id == TYPE_F16) {
        // IEEE 754 half-precision: 1 sign, 5 exponent, 10 mantissa bits
        let bits = buf.read_u16_le(index);
        let exp = (bits >> 10) & 31;
        let mant = bits & 1023;
        let val = 0.0;
        if (exp == 31) {
            if (mant == 0) { val = INF; } else { val = NAN; }
        } else {
            let scale = 0.00006103515625; // 2^-14 (subnormal scale)
            if (exp > 0) {
                mant = mant + 1024; // implicit leading bit
                let e = exp - 1;
                while (e > 0) {
                    scale = scale * 2.0;
                    e = e - 1;
                }
            }
            val = mant * scale * 0.0009765625; // mantissa is in 1/1024 units
        }
        if ((bits >> 15) != 0) {
            val = 0.0 - val;
        }
        return { data: val, size: 2, valid: true };
    } else if (type_id == TYPE_F32) {
        return { data: buf.read_f32_le(index), size: 4, valid: true };
    } else if (type_id == TYPE_F64) {
        return { data: buf.read_f64_le(index), size: 8, valid: true };
    } else if (type_id == TYPE_STRING) {
        if (index + 2 > buf.length) {
            return { data: null, size: 0, valid: false };
        }
        let str_len = buf.read_u16_le(index);
        index = index + 2;
        if (index + str_len > buf.length) {
            return { data: null, size: 0, valid: false };
        }
        // Strip null terminator if present
        let str_end = str_len;
        if (str_len > 0 && buf.read_u8(index + str_len - 1) == 0) {
            str_end = str_len - 1;
        }
        let val = "";
        if (str_end > 0) {
            val = from_bytes(buf.slice(index, index + str_end));
        }
        return { data: val, size: str_len + 2, valid: true };
    } else if (type_id == TYPE_BUFFER) {
        if (index + 1 > buf.length) {
            return { data: null, size: 0, valid: false };
        }
        let buf_len = buf.read_u8(index);
        if (index + 1 + buf_len > buf.length) {
            return { data: null, size: 0, valid: false };
        }
        return { data: buf.read_bytes(index + 1, buf_len), size: buf_len + 1, valid: true };
    }

    // TYPE_UNDEFINED
    return { data: null, size: 0, valid: true };
}
