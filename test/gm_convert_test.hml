// Tests for gm_convert.hml - binary data type conversion
// Run with: hemlock test/gm_convert_test.hml

import { determine_type, create_buffer_from_data, parse_data_from_buffer } from "../src/util/gm_convert.hml";

let tests_passed = 0;
let tests_failed = 0;

fn test(name, test_fn) {
    try {
        test_fn();
        print("  pass: " + name);
        tests_passed = tests_passed + 1;
    } catch (e) {
        print("  FAIL: " + name + " - " + e);
        tests_failed = tests_failed + 1;
    }
}

// ===== determine_type =====
print("determine_type:");

test("u8 for 0", fn() { assert(determine_type(0) == 0); });
test("u8 for 255", fn() { assert(determine_type(255) == 0); });
test("u16 for 256", fn() { assert(determine_type(256) == 1); });
test("u16 for 65535", fn() { assert(determine_type(65535) == 1); });
test("u32 for 65536", fn() { assert(determine_type(65536) == 2); });
test("s8 for -1", fn() { assert(determine_type(-1) == 3); });
test("s8 for -128", fn() { assert(determine_type(-128) == 3); });
test("s16 for -129", fn() { assert(determine_type(-129) == 4); });
test("s16 for -32768", fn() { assert(determine_type(-32768) == 4); });
test("s32 for -32769", fn() { assert(determine_type(-32769) == 5); });
test("f32 for 3.14", fn() { assert(determine_type(3.14) == 7); });
test("string", fn() { assert(determine_type("hello") == 9); });
test("undefined for null", fn() { assert(determine_type(null) == 11); });

// ===== Roundtrip tests =====
print("");
print("create/parse roundtrip:");

fn roundtrip(name, value) {
    test(name, fn() {
        let buf = create_buffer_from_data(value);
        let result = parse_data_from_buffer(buf, 0);
        assert(result.data == value, "Expected " + value + " got " + result.data);
    });
}

roundtrip("u8: 0", 0);
roundtrip("u8: 42", 42);
roundtrip("u8: 255", 255);
roundtrip("u16: 256", 256);
roundtrip("u16: 1000", 1000);
roundtrip("u16: 65535", 65535);
roundtrip("u32: 65536", 65536);
roundtrip("u32: 100000", 100000);
roundtrip("s8: -1", -1);
roundtrip("s8: -128", -128);
roundtrip("s16: -129", -129);
roundtrip("s16: -32768", -32768);
roundtrip("s32: -32769", -32769);
roundtrip("string: hello", "hello");
roundtrip("string: empty", "");

// Float roundtrip (approximate comparison needed)
test("f32: 3.14", fn() {
    let buf = create_buffer_from_data(3.14);
    let result = parse_data_from_buffer(buf, 0);
    let diff = result.data - 3.14;
    if (diff < 0) { diff = 0 - diff; }
    assert(diff < 0.001, "Expected ~3.14 got " + result.data);
});

test("null roundtrip", fn() {
    let buf = create_buffer_from_data(null);
    let result = parse_data_from_buffer(buf, 0);
    assert(result.data == null);
});

// Buffer roundtrip
test("buffer roundtrip", fn() {
    let src = buffer(3);
    src[0] = 0xAA;
    src[1] = 0xBB;
    src[2] = 0xCC;
    let buf = create_buffer_from_data(src);
    let result = parse_data_from_buffer(buf, 0);
    assert(result.data.length == 3, "Buffer length mismatch");
    assert(result.data[0] == 0xAA, "Byte 0 mismatch");
    assert(result.data[1] == 0xBB, "Byte 1 mismatch");
    assert(result.data[2] == 0xCC, "Byte 2 mismatch");
});

// ===== Multi-value parsing =====
print("");
print("multi-value parsing:");

test("parse multiple values from buffer", fn() {
    let b1 = create_buffer_from_data(42);
    let b2 = create_buffer_from_data("hi");
    let b3 = create_buffer_from_data(-5);

    // Concatenate
    let total = b1.length + b2.length + b3.length;
    let combined = buffer(total);
    let off = 0;
    let i = 0;
    while (i < b1.length) { combined[off] = b1[i]; off = off + 1; i = i + 1; }
    i = 0;
    while (i < b2.length) { combined[off] = b2[i]; off = off + 1; i = i + 1; }
    i = 0;
    while (i < b3.length) { combined[off] = b3[i]; off = off + 1; i = i + 1; }

    let idx = 0;
    let r1 = parse_data_from_buffer(combined, idx);
    assert(r1.data == 42, "First value should be 42");
    idx = idx + r1.size + 1;

    let r2 = parse_data_from_buffer(combined, idx);
    assert(r2.data == "hi", "Second value should be 'hi'");
    idx = idx + r2.size + 1;

    let r3 = parse_data_from_buffer(combined, idx);
    assert(r3.data == -5, "Third value should be -5");
});

// ===== Edge cases =====
print("");
print("edge cases:");

test("out of bounds returns null", fn() {
    let buf = buffer(1);
    buf[0] = 0;
    let result = parse_data_from_buffer(buf, 5);
    assert(result.data == null);
    assert(result.size == -1);
});

test("invalid type returns null", fn() {
    let buf = buffer(1);
    buf[0] = 99;
    let result = parse_data_from_buffer(buf, 0);
    assert(result.data == null);
    assert(result.size == -1);
});

fn bytes(arr) {
    let b = buffer(arr.length);
    let i = 0;
    while (i < arr.length) { b[i] = arr[i]; i = i + 1; }
    return b;
}

let truncated = [
    ["u8", [0]], ["u16", [1, 0]], ["u32", [2, 0, 0, 0]], ["s8", [3]], ["s16", [4, 0]],
    ["s32", [5, 0, 0, 0]], ["f16", [6, 0]], ["f32", [7, 0, 0, 0]], ["f64", [8, 0, 0, 0, 0, 0, 0, 0]],
    ["string length", [9, 5]], ["string body", [9, 5, 0, 97, 98]], ["buffer length", [10]],
    ["buffer body", [10, 4, 1, 2]],
];
let ti = 0;
while (ti < truncated.length) {
    let entry = truncated[ti];
    test("truncated " + entry[0] + " fails without throwing", fn() {
        let result = parse_data_from_buffer(bytes(entry[1]), 0);
        assert(result.size == -1);
    });
    ti = ti + 1;
}

test("undefined parses with size 0 (not a failure)", fn() {
    let result = parse_data_from_buffer(bytes([11]), 0);
    assert(result.data == null && result.size == 0);
});

fn f16(bits) {
    return parse_data_from_buffer(bytes([6, bits & 255, bits >> 8]), 0);
}

test("f16 consumes 2 bytes", fn() { assert(f16(15360).size == 2); });
test("f16 1.0", fn() { assert(f16(15360).data == 1.0); });            // 0x3c00
test("f16 -2.0", fn() { assert(f16(49152).data == -2.0); });          // 0xc000
test("f16 max 65504", fn() { assert(f16(31743).data == 65504.0); });  // 0x7bff
test("f16 1/3", fn() {                                                // 0x3555
    let d = f16(13653).data - 0.333;
    assert(d < 0.001 && d > -0.001);
});
test("f16 smallest subnormal", fn() { assert(f16(1).data == 1.0 / 16777216.0); });
test("f16 +inf", fn() { assert(f16(31744).data > 1.0e300); });        // 0x7c00
test("f16 -inf", fn() { assert(f16(64512).data < -1.0e300); });       // 0xfc00
test("f16 NaN", fn() { let n = f16(32256).data; assert(n != n); });   // 0x7e00

test("oversized buffer throws", fn() {
    let big = buffer(256);
    let threw = false;
    try {
        create_buffer_from_data(big);
    } catch (e) {
        threw = true;
    }
    assert(threw, "buffer > 255 bytes should throw, not wrap the u8 length field");
});

test("max-size buffer ok", fn() {
    let big = buffer(255);
    let buf = create_buffer_from_data(big);
    let result = parse_data_from_buffer(buf, 0);
    assert(result.data.length == 255);
});

// ===== Summary =====
print("");
print("========================================");
print("gmConvert Tests: " + tests_passed + " passed, " + tests_failed + " failed");
print("========================================");
assert(tests_failed == 0, "All tests should pass");
