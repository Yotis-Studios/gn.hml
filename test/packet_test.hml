// Tests for packet.hml - packet serialization
// Run with: hemlock test/packet_test.hml

import { Packet } from "../src/network/packet.hml";

let tests_passed = 0;
let tests_failed = 0;

fn test(name, test_fn) {
    try {
        test_fn();
        print("  pass: " + name);
        tests_passed = tests_passed + 1;
    } catch (e) {
        print("  FAIL: " + name + " - " + e);
        tests_failed = tests_failed + 1;
    }
}

// ===== Constructor =====
print("constructor:");

test("sets netId", fn() {
    let p = Packet(5);
    assert(p.net_id == 5);
});

test("starts with empty data", fn() {
    let p = Packet(1);
    assert(p.data.length == 0);
});

// ===== add/get =====
print("");
print("add/get:");

test("add single value", fn() {
    let p = Packet(1);
    p.add(42);
    assert(p.data.length == 1);
    assert(p.get(0) == 42);
});

test("add multiple values", fn() {
    let p = Packet(1);
    p.add(1);
    p.add("hello");
    p.add(-5);
    assert(p.data.length == 3);
    assert(p.get(0) == 1);
    assert(p.get(1) == "hello");
    assert(p.get(2) == -5);
});

test("add array", fn() {
    let p = Packet(1);
    p.add([10, 20, 30]);
    assert(p.data.length == 3);
    assert(p.get(0) == 10);
    assert(p.get(1) == 20);
    assert(p.get(2) == 30);
});

// ===== build/load roundtrip =====
print("");
print("build/load roundtrip:");

test("empty packet", fn() {
    let p = Packet(7);
    let built = p.build();
    // size(2) + netId(2) = 4 bytes minimum, size field = 2
    assert(built.length == 4, "Empty packet should be 4 bytes");
    // size field should be 2 (just netId)
    assert(built[0] == 2);
    assert(built[1] == 0);
    // netId = 7
    assert(built[2] == 7);
    assert(built[3] == 0);
});

test("packet with u8", fn() {
    let p = Packet(1);
    p.add(42);
    let built = p.build();

    let p2 = Packet(0);
    // Load from after the size header
    let payload = buffer(built.length - 2);
    let i = 0;
    while (i < payload.length) {
        payload[i] = built[i + 2];
        i = i + 1;
    }
    p2.load(payload);
    assert(p2.net_id == 1, "netId should be 1");
    assert(p2.data.length == 1, "Should have 1 data element");
    assert(p2.get(0) == 42, "Data should be 42");
});

test("packet with mixed types", fn() {
    let p = Packet(100);
    p.add(255);
    p.add("test");
    p.add(-10);
    p.add(1000);

    let built = p.build();

    let p2 = Packet(0);
    let payload = buffer(built.length - 2);
    let i = 0;
    while (i < payload.length) {
        payload[i] = built[i + 2];
        i = i + 1;
    }
    p2.load(payload);

    assert(p2.net_id == 100, "netId should be 100");
    assert(p2.data.length == 4, "Should have 4 data elements");
    assert(p2.get(0) == 255, "First value");
    assert(p2.get(1) == "test", "Second value");
    assert(p2.get(2) == -10, "Third value");
    assert(p2.get(3) == 1000, "Fourth value");
});

test("large netId", fn() {
    let p = Packet(60000);
    p.add(1);
    let built = p.build();

    let p2 = Packet(0);
    let payload = buffer(built.length - 2);
    let i = 0;
    while (i < payload.length) {
        payload[i] = built[i + 2];
        i = i + 1;
    }
    p2.load(payload);
    assert(p2.net_id == 60000, "netId should be 60000");
});

test("undersized data ignored", fn() {
    let p = Packet(0);
    let tiny = buffer(1);
    tiny[0] = 5;
    p.load(tiny);
    assert(p.data.length == 0, "Should have no data from undersized buffer");
});

test("oversized payload throws", fn() {
    // 17 strings x ~4KB each = ~69KB payload, over the u16 size field max
    let big = "";
    let i = 0;
    while (i < 256) {
        big = big + "0123456789abcdef";
        i = i + 1;
    }
    let p = Packet(1);
    i = 0;
    while (i < 17) {
        p.add(big);
        i = i + 1;
    }
    let threw = false;
    try {
        p.build();
    } catch (e) {
        threw = true;
    }
    assert(threw, "payload > 65535 bytes should throw, not corrupt framing");
});

// ===== Load robustness =====
print("load robustness:");

fn load_bytes(arr) {
    let b = buffer(arr.length);
    let i = 0;
    while (i < arr.length) { b[i] = arr[i]; i = i + 1; }
    let p = Packet(0);
    p.load(b);
    return p;
}

test("undefined in the middle does not truncate the packet", fn() {
    let p = Packet(1);
    p.add([1, null, 2, "x"]);
    let b = p.build();
    let q = Packet(0);
    q.load(b.slice(2, b.length));
    assert(q.data.length == 4, "expected 4 values, got " + q.data.length);
    assert(q.get(0) == 1 && q.get(1) == null && q.get(2) == 2 && q.get(3) == "x");
});

test("truncated data keeps values before it and does not throw", fn() {
    let q = load_bytes([1, 0, 0, 7, 1, 5]);
    assert(q.net_id == 1);
    assert(q.data.length == 1 && q.get(0) == 7);
});

test("string with length past the end does not throw", fn() {
    let q = load_bytes([1, 0, 9, 255, 255, 97]);
    assert(q.data.length == 0);
});

test("f16 followed by more data parses", fn() {
    let q = load_bytes([1, 0, 6, 0, 60, 0, 7]);
    assert(q.data.length == 2 && q.get(0) == 1.0 && q.get(1) == 7);
});

// ===== Range checks (match gn.js, where Buffer throws RangeError) =====
print("range checks:");

fn throws(f) {
    try { f(); } catch (e) { return true; }
    return false;
}

test("integer above u32 max throws", fn() {
    let p = Packet(1);
    p.add(4294967296);
    assert(throws(fn() { p.build(); }), "should throw, not wrap to 0");
});

test("integer below s32 min throws", fn() {
    let p = Packet(1);
    p.add(-2147483649);
    assert(throws(fn() { p.build(); }), "should throw, not wrap");
});

test("u32 max and s32 min still build", fn() {
    let p = Packet(1);
    p.add([4294967295, -2147483648]);
    let q = Packet(0);
    let b = p.build();
    q.load(b.slice(2, b.length));
    assert(q.get(0) == 4294967295 && q.get(1) == -2147483648);
});

test("net_id above u16 max throws", fn() {
    let p = Packet(70000);
    assert(throws(fn() { p.build(); }), "should throw, not wrap");
});

// ===== Summary =====
print("");
print("========================================");
print("Packet Tests: " + tests_passed + " passed, " + tests_failed + " failed");
print("========================================");
assert(tests_failed == 0, "All tests should pass");
