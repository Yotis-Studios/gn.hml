// Tests for Server and Client - integration test
// Run with: hemlock test/server_client_test.hml

import { Server } from "../src/network/server.hml";
import { Client } from "../src/network/client.hml";
import { Packet } from "../src/network/packet.hml";
import { sleep } from "@stdlib/time";

let tests_passed = 0;
let tests_failed = 0;
let test_port = 19070;

fn next_port() {
    test_port = test_port + 1;
    return test_port;
}

fn test(name, test_fn) {
    try {
        test_fn();
        print("  pass: " + name);
        tests_passed = tests_passed + 1;
    } catch (e) {
        print("  FAIL: " + name + " - " + e);
        tests_failed = tests_failed + 1;
    }
    sleep(0.3);
}

async fn run_server(srv, p) {
    srv.listen(p);
}

print("server/client integration:");

test("client connects and receives echo", fn() {
    let port = next_port();
    let server = Server();
    server.on("packet", fn(conn, packet) {
        conn.send(packet);
    });
    spawn(run_server, server, port);
    sleep(0.5);

    let client = Client();
    try {
        client.connect("127.0.0.1", port);
        assert(client.is_connected() == true, "Client should be connected");

        let p = Packet(1);
        p.add(42);
        client.send(p);

        let echo = client.recv_packet();
        assert(echo != null, "Should receive echo");
        assert(echo.get(0) == 42, "Echo should be 42");
    } finally {
        client.disconnect();
        sleep(0.3);
        server.close();
        sleep(0.3);
    }
});

test("string data roundtrip", fn() {
    let port = next_port();
    let server = Server();
    server.on("packet", fn(conn, packet) {
        conn.send(packet);
    });
    spawn(run_server, server, port);
    sleep(0.5);

    let client = Client();
    try {
        client.connect("127.0.0.1", port);

        let p = Packet(1);
        p.add("hello world");
        client.send(p);

        let echo = client.recv_packet();
        assert(echo != null, "Should receive echo");
        assert(echo.get(0) == "hello world", "Echo should be 'hello world'");
    } finally {
        client.disconnect();
        sleep(0.3);
        server.close();
        sleep(0.3);
    }
});

test("mixed data types", fn() {
    let port = next_port();
    let server = Server();
    server.on("packet", fn(conn, packet) {
        conn.send(packet);
    });
    spawn(run_server, server, port);
    sleep(0.5);

    let client = Client();
    try {
        client.connect("127.0.0.1", port);

        let p = Packet(5);
        p.add(0);
        p.add(1000);
        p.add(-50);
        p.add("world");
        client.send(p);

        let echo = client.recv_packet();
        assert(echo != null, "Should receive echo");
        assert(echo.data.length == 4, "Should have 4 values");
        assert(echo.get(0) == 0, "Value 0");
        assert(echo.get(1) == 1000, "Value 1");
        assert(echo.get(2) == -50, "Value 2");
        assert(echo.get(3) == "world", "Value 3");
    } finally {
        client.disconnect();
        sleep(0.3);
        server.close();
        sleep(0.3);
    }
});

test("multiple packets", fn() {
    let port = next_port();
    let server = Server();
    server.on("packet", fn(conn, packet) {
        conn.send(packet);
    });
    spawn(run_server, server, port);
    sleep(0.5);

    let client = Client();
    try {
        client.connect("127.0.0.1", port);

        let i = 0;
        while (i < 3) {
            let p = Packet(1);
            p.add(i * 10);
            client.send(p);

            let echo = client.recv_packet();
            assert(echo != null, "Should receive echo " + i);
            assert(echo.get(0) == i * 10, "Echo value " + i);
            i = i + 1;
        }
    } finally {
        client.disconnect();
        sleep(0.3);
        server.close();
        sleep(0.3);
    }
});

test("large netId", fn() {
    let port = next_port();
    let server = Server();
    server.on("packet", fn(conn, packet) {
        conn.send(packet);
    });
    spawn(run_server, server, port);
    sleep(0.5);

    let client = Client();
    try {
        client.connect("127.0.0.1", port);

        let p = Packet(60000);
        p.add(99);
        client.send(p);

        let echo = client.recv_packet();
        assert(echo != null, "Should receive echo");
        assert(echo.net_id == 60000, "netId should be 60000");
        assert(echo.get(0) == 99, "Data should be 99");
    } finally {
        client.disconnect();
        sleep(0.3);
        server.close();
        sleep(0.3);
    }
});

test("recv_packet returns every packet in a multi-packet message", fn() {
    let port = next_port();
    let server = Server();
    server.on("packet", fn(conn, packet) {
        let a = Packet(1);
        a.add(10);
        let b = Packet(2);
        b.add(20);
        let ba = a.build();
        let bb = b.build();
        let both = buffer(ba.length + bb.length);
        let i = 0;
        while (i < ba.length) { both[i] = ba[i]; i = i + 1; }
        let j = 0;
        while (j < bb.length) { both[i + j] = bb[j]; j = j + 1; }
        conn.send(both);
    });
    spawn(run_server, server, port);
    sleep(0.5);

    let client = Client();
    try {
        client.connect("127.0.0.1", port);
        client.send(Packet(9));

        let p1 = client.recv_packet();
        let p2 = client.recv_packet();
        assert(p1 != null && p1.net_id == 1 && p1.get(0) == 10, "first packet");
        assert(p2 != null && p2.net_id == 2 && p2.get(0) == 20, "second packet should not be dropped");
    } finally {
        client.disconnect();
        sleep(0.3);
        server.close();
        sleep(0.3);
    }
});

test("close() from the spawning task stops the server", fn() {
    let port = next_port();
    let server = Server();
    server.on("packet", fn(conn, packet) {
        conn.send(packet);
    });
    let task = spawn(run_server, server, port);
    sleep(0.5);

    server.close();
    join(task); // listen() must have returned

    let client = Client();
    client.connect("127.0.0.1", port);
    assert(!client.is_connected(), "server should no longer accept connections");
    server.close(); // second close is a no-op
});

test("close() from inside a callback stops the server", fn() {
    let port = next_port();
    let server = Server();
    server.on("packet", fn(conn, packet) {
        conn.send(packet);
        conn.server.close();
    });
    let task = spawn(run_server, server, port);
    sleep(0.5);

    let client = Client();
    try {
        client.connect("127.0.0.1", port);
        client.send(Packet(1));
        assert(client.recv_packet() != null, "should get echo before close");
        join(task);
    } finally {
        client.disconnect();
    }
});

test("text message is reported as an error", fn() {
    let port = next_port();
    let server = Server();
    server.on("error", fn(err, conn) {
        // reply so the client can observe that the error fired with a connection
        let p = Packet(77);
        p.add(err);
        conn.send(p);
    });
    spawn(run_server, server, port);
    sleep(0.5);

    let client = Client();
    try {
        client.connect("127.0.0.1", port);
        client._ws.send_text("hello");
        let reply = client.recv_packet();
        assert(reply != null && reply.net_id == 77, "error handler should fire");
        assert(reply.get(0) == "Received non-binary data: hello", "got: " + reply.get(0));
    } finally {
        client.disconnect();
        sleep(0.3);
        server.close();
    }
});

test("a send to a kicked connection is quiet, and an error handler cannot recurse", fn() {
    // A server that kicks a connection usually still holds it until the disconnect event comes
    // round, and sends to it meanwhile: a broadcast, a timer's snapshot, a host switch. Each
    // such send threw "Cannot send on closed WebSocket" into on("error"), and a handler that
    // answers by sending on that connection (shikikan's sends a PLAYER_KICK) threw again from
    // inside its own catch: about 3,900 levels deep the C stack ran out and the whole server
    // died with a segfault, every other client with it. The handlers count on the listening
    // server itself (conn.server): spawn gives each closure its own copy of what it captures.
    let port = next_port();
    let server = Server();
    server.seen_errors = 0;
    server.seen_disconnects = 0;
    server.on("packet", fn(conn, packet) {
        let what = packet.get(0);
        if (what == 1) {
            conn.kick();
            conn.send(packet);
            conn.send(packet);
        } else if (what == 2) {
            let p = Packet(2);
            p.add(conn.server.seen_errors);
            p.add(conn.server.seen_disconnects);
            conn.send(p);
        }
    });
    server.on("error", fn(err, conn) {
        if (conn != null) {
            conn.server.seen_errors = conn.server.seen_errors + 1;
            let kick = Packet(99);
            kick.add("An error occurred sending data.");
            conn.send(kick);
        }
    });
    server.on("disconnect", fn(conn) {
        conn.server.seen_disconnects = conn.server.seen_disconnects + 1;
    });
    spawn(run_server, server, port);
    sleep(0.5);

    let a = Client();
    a.connect("127.0.0.1", port);
    let kick_me = Packet(1);
    kick_me.add(1);
    a.send(kick_me);
    sleep(0.5);
    a.disconnect();
    sleep(0.3);

    let b = Client();
    try {
        b.connect("127.0.0.1", port);
        let ask = Packet(1);
        ask.add(2);
        b.send(ask);
        let counts = b.recv_packet();
        assert(counts != null, "the server should still answer after the kick");
        assert(counts.get(0) == 0, "a send to a kicked connection should not be an error, got " + counts.get(0));
        assert(counts.get(1) == 1, "the kicked connection's disconnect should be reported, got " + counts.get(1));
    } finally {
        b.disconnect();
        sleep(0.3);
        server.close();
    }
});

test("an error handler that resends a failing send is told once", fn() {
    // The other half of the guard: a send that throws on an open connection (here a value
    // send_binary refuses), answered by a handler that tries the same send again.
    let port = next_port();
    let server = Server();
    server.seen_errors = 0;
    server.on("packet", fn(conn, packet) {
        if (packet.get(0) == 1) {
            conn.send("not a buffer");
            let p = Packet(2);
            p.add(conn.server.seen_errors);
            conn.send(p);
        }
    });
    server.on("error", fn(err, conn) {
        conn.server.seen_errors = conn.server.seen_errors + 1;
        conn.send("not a buffer");
    });
    spawn(run_server, server, port);
    sleep(0.5);

    let a = Client();
    try {
        a.connect("127.0.0.1", port);
        let p = Packet(1);
        p.add(1);
        a.send(p);
        let counts = a.recv_packet();
        assert(counts != null, "the server should answer after the failed send");
        assert(counts.get(0) == 1, "the handler should be told once, got " + counts.get(0));
    } finally {
        a.disconnect();
        sleep(0.3);
        server.close();
    }
});

// ===== Summary =====
print("");
print("========================================");
print("Server/Client Tests: " + tests_passed + " passed, " + tests_failed + " failed");
print("========================================");
assert(tests_failed == 0, "All tests should pass");
